.version 7.0
.target sm_75
.address_size 64

// AI Workload Kernel: Fused Affine + ReLU Activation
// y[i] = max(0.0f, alpha * x[i] + beta)
// Models a standard fused neural network layer (scale + bias + ReLU)
.visible .entry ai_fused_activation(
    .param .u64 param_x,
    .param .u64 param_y,
    .param .f32 param_alpha,
    .param .f32 param_beta,
    .param .u32 param_n
)
{
    .reg .pred  %p<2>;
    .reg .f32   %f<6>;
    .reg .b32   %r<6>;
    .reg .b64   %rd<7>;

    ld.param.u64    %rd1, [param_x];
    ld.param.u64    %rd2, [param_y];
    ld.param.f32    %f1, [param_alpha];
    ld.param.f32    %f2, [param_beta];
    ld.param.u32    %r1, [param_n];

    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.s32      %r5, %r2, %r3, %r4;

    setp.ge.u32     %p1, %r5, %r1;
    @%p1 bra        DONE;

    cvta.to.global.u64  %rd3, %rd1;
    cvta.to.global.u64  %rd4, %rd2;
    mul.wide.u32    %rd5, %r5, 4;
    add.s64         %rd6, %rd3, %rd5;
    ld.global.f32   %f3, [%rd6];

    // f4 = alpha * x[i] + beta
    fma.rn.f32      %f4, %f3, %f1, %f2;
    // f5 = max(0.0f, f4) -> ReLU
    mov.f32         %f5, 0f00000000;
    max.f32         %f5, %f4, %f5;

    add.s64         %rd6, %rd4, %rd5;
    st.global.f32   [%rd6], %f5;

DONE:
    ret;
}
